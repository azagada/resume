// Cloudflare Workers settings. Cloudflare reads this file when it deploys the site.
{
  // Must match the Worker's name in the Cloudflare dashboard
  "name": "resume",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Everything visitors see
    "directory": "./site",
    // Contact-form requests go to the Worker; everything else is served straight from site/
    "run_worker_first": ["/api/*"]
  },
  // Keep the settings you add in the dashboard (Settings → Variables and Secrets) on every deploy
  "keep_vars": true,
  // Keep the Worker's log messages (for example, "Microsoft sign-in failed") in the dashboard
  "observability": {
    "enabled": true
  }
}
{
  // ...
  "vars": {
    "GRAPH_CLIENT_ID": "a51992c6-1f53-4b58-be36-71ab73b6b85a",
    "GRAPH_TENANT_ID": "a51992c6-1f53-4b58-be36-71ab73b6b85a",
    "MAIL_SENDER": "website.aldo@zagada.us",
    "MAIL_TO": "aldo@zagada.co",
    "TURNSTILE_HOSTNAMES": "aldo.zagada.me"
  },
  // ...
}
